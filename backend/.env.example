PORT=5000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_of_at_least_32_characters
# Comma-separated list of frontend origins allowed to call the API
CLIENT_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
SUPABASE_URL=https://your-project-ref.supabase.co
# The service_role / secret key. Server-side only, never put it in the frontend.
SUPABASE_SERVICE_KEY=replace_with_your_supabase_secret_key